<?xml version="1.0" encoding="utf-8"?>
<!-- Tela 13 · Perfil & Fidelidade Ossos da Tribo (mobile 390) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hb_cream">

    <include
        android:id="@+id/appBar"
        layout="@layout/view_app_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin">

            <!-- Cabeçalho do Perfil -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAvatarInitials"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_avatar_orange"
                    android:gravity="center"
                    android:text="MS"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfileName"
                        style="@style/HB.Text.H2"
                        android:text="Marina Souza" />

                    <TextView
                        android:id="@+id/tvProfileSubtitle"
                        style="@style/HB.Text.Muted"
                        android:text="Caçadora · desde 2024"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card de Fidelidade "OSSOS DA TRIBO" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_l"
                android:background="@drawable/bg_loyalty_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/HB.Text.Eyebrow"
                        android:text="@string/loyalty_bones_title"
                        android:textColor="@color/hb_stone_dark" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        style="@style/HB.Text.Muted"
                        android:text="160 pra Xamã"
                        android:textColor="@color/hb_stone_dark"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvBonesBalance"
                        style="@style/HB.Text.H1"
                        android:text="340"
                        android:textColor="@color/white" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_bone" />
                </LinearLayout>

                <TextView
                    style="@style/HB.Text.Muted"
                    android:layout_marginTop="2dp"
                    android:text="@string/loyalty_bones_discount"
                    android:textColor="@color/hb_sand"
                    android:textSize="11sp" />

                <!-- Barra de Progresso de Nível -->
                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="12dp"
                    android:progress="65"
                    android:progressDrawable="@drawable/bg_chip_selected" />
            </LinearLayout>

            <!-- Seção: Dados Pessoais -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_l"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPersonalDataTitle"
                        style="@style/HB.Text.H3"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/menu_personal_data" />

                    <TextView
                        android:id="@+id/btnEditPersonal"
                        style="@style/HB.Text.Muted"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/btn_edit"
                        android:textColor="@color/hb_orange"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPersonalName"
                    style="@style/HB.Text"
                    android:layout_marginTop="8dp"
                    android:text="Marina Souza"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPersonalContact"
                    style="@style/HB.Text.Muted"
                    android:text="marina@tribo.com · +55 54 9 0000-0000"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Seção: Membros da Tribo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTribeMembersTitle"
                        style="@style/HB.Text.H3"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/menu_tribe_members" />

                    <TextView
                        android:id="@+id/btnAddMember"
                        style="@style/HB.Text.Muted"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/btn_add"
                        android:textColor="@color/hb_orange"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/membersContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">
                </LinearLayout>
            </LinearLayout>

            <!-- Menus Adicionais -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/menuSavedPayments"
                    style="@style/HB.Text"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/menu_saved_payments" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/hb_stone" />

                <TextView
                    android:id="@+id/menuFavoriteCaverns"
                    style="@style/HB.Text"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/menu_favorite_caverns" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/hb_stone" />

                <TextView
                    android:id="@+id/menuNotifications"
                    style="@style/HB.Text"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/menu_notifications" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/hb_stone" />

                <TextView
                    android:id="@+id/menuLanguage"
                    style="@style/HB.Text"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/menu_language" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/hb_stone" />

                <TextView
                    android:id="@+id/menuHelp"
                    style="@style/HB.Text"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/menu_help" />
            </LinearLayout>

            <!-- Botão Sair da Caverna -->
            <LinearLayout
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_l"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_logout" />

                <TextView
                    android:id="@+id/tvLogoutText"
                    style="@style/HB.Text"
                    android:layout_marginStart="8dp"
                    android:text="@string/menu_logout"
                    android:textColor="@color/hb_red"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/hb_paper"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>
