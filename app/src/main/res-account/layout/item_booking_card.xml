<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/gap_m"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Status & Código -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvBookingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="@string/status_confirmed"
            android:textColor="@color/hb_green"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvBookingCode"
            style="@style/HB.Text.Muted"
            android:text="HB-4F7K"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Título da Caverna -->
    <TextView
        android:id="@+id/tvCavernTitle"
        style="@style/HB.Text.H2"
        android:layout_marginTop="8dp"
        android:text="@string/cavern_1_name" />

    <!-- Datas -->
    <TextView
        android:id="@+id/tvBookingDates"
        style="@style/HB.Text.Muted"
        android:layout_marginTop="2dp"
        android:text="📅 12 – 15 out"
        android:textSize="12sp" />

    <!-- Soma dos Gastos e Quantidade de Pessoas -->
    <TextView
        android:id="@+id/tvBookingTotalAndPeople"
        style="@style/HB.Text"
        android:layout_marginTop="4dp"
        android:textColor="@color/hb_dark"
        android:textSize="13sp"
        android:textStyle="bold"
        android:text="💰 Total: R$ 1.560,00   👥 2 pessoas na tribo" />

    <!-- Atividades Agendadas Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            style="@style/HB.Chip"
            android:layout_marginEnd="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Escavação · sáb 10h"
            android:textSize="11sp" />

        <TextView
            style="@style/HB.Chip"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Jantar · sáb 20h"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Botões de Gerenciamento -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnVoucher"
            style="@style/HB.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/voucher_title"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnManageExperiences"
            style="@style/HB.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="Gerenciar"
            android:textColor="@color/hb_ink"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnCancelBooking"
            style="@style/HB.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Cancelar"
            android:textColor="@color/hb_red"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
