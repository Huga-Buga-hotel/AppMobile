<?xml version="1.0" encoding="utf-8"?>
<!-- Tela 10 · Onboarding do App (mobile 390) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hb_dark">

    <!-- Top Bar com Pular -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            style="@style/HB.Text.Eyebrow"
            android:text="PT · EN · ES"
            android:textColor="@color/hb_stone_dark" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnSkip"
            style="@style/HB.Text"
            android:text="@string/onboarding_skip"
            android:textColor="@color/white"
            android:textSize="13sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin">

            <!-- Quadro de Ilustração / Foto -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:background="@drawable/bg_photo_placeholder">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_image_placeholder" />

                <TextView
                    style="@style/HB.Text.Muted"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:text="Ilustração/foto: mamute na entrada do hotel"
                    android:textSize="11sp" />
            </FrameLayout>

            <!-- Textos Onboarding -->
            <TextView
                style="@style/HB.Text.Eyebrow"
                android:layout_marginTop="@dimen/gap_l"
                android:text="@string/onboarding_1_eyebrow"
                android:textColor="@color/hb_orange" />

            <TextView
                style="@style/HB.Text.H1"
                android:layout_marginTop="6dp"
                android:text="@string/onboarding_1_title"
                android:textColor="@color/white" />

            <TextView
                style="@style/HB.Text.Muted"
                android:layout_marginTop="@dimen/gap_s"
                android:text="@string/onboarding_1_desc"
                android:textColor="@color/hb_stone_dark"
                android:textSize="@dimen/text_body" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Rodapé: Indicadores de Página + Botão Próximo -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/screen_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Dots Indicadores -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_dots_indicator" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip" />
        </LinearLayout>

        <TextView
            style="@style/HB.Button.Primary"
            android:layout_width="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/onboarding_next" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
