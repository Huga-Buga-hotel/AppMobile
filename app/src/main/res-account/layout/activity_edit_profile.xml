<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hb_cream">

    <include
        android:id="@+id/appBar"
        layout="@layout/view_app_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin">

            <TextView
                style="@style/HB.Text.H1"
                android:text="Editar Informações" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Nome -->
                <TextView
                    style="@style/HB.Text.Muted"
                    android:text="Nome completo"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etName"
                    style="@style/HB.Text"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4px"
                    android:background="@drawable/bg_chip"
                    android:inputType="textPersonName"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="13sp" />

                <!-- Celular -->
                <TextView
                    style="@style/HB.Text.Muted"
                    android:layout_marginTop="12dp"
                    android:text="Celular"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etPhone"
                    style="@style/HB.Text"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4px"
                    android:background="@drawable/bg_chip"
                    android:hint="(00) 00000-0000"
                    android:inputType="phone"
                    android:maxLength="15"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="13sp" />

                <!-- Data de Nascimento -->
                <TextView
                    style="@style/HB.Text.Muted"
                    android:layout_marginTop="12dp"
                    android:text="Data de Nascimento (AAAA-MM-DD)"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etBirthDate"
                    style="@style/HB.Text"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4px"
                    android:background="@drawable/bg_chip"
                    android:inputType="date"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="13sp" />

                <!-- Aceita Ofertas -->
                <CheckBox
                    android:id="@+id/cbOffers"
                    style="@style/HB.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Aceito receber ofertas da tribo por e-mail"
                    android:textSize="12sp" />

                <!-- Botão Salvar -->
                <TextView
                    android:id="@+id/btnSave"
                    style="@style/HB.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_marginTop="20dp"
                    android:text="Salvar Alterações 🪨" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
