<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/hb_orange_dark" />
                    <corners android:radius="@dimen/radius_chip" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="0dp" android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/hb_orange_dark" />
                    <corners android:radius="@dimen/radius_chip" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/hb_orange" />
                    <corners android:radius="@dimen/radius_chip" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
