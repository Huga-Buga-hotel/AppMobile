<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hb_dark" />
            <stroke android:width="@dimen/border" android:color="@color/hb_ink" />
            <corners android:radius="@dimen/radius_chip" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/hb_muted"
                android:dashWidth="4dp" android:dashGap="3dp" />
            <corners android:radius="@dimen/radius_chip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hb_paper" />
            <stroke android:width="@dimen/border" android:color="@color/hb_ink" />
            <corners android:radius="@dimen/radius_chip" />
        </shape>
    </item>
</selector>
