<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="HB.AgendaRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/gap_m</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="HB.AgendaHour" parent="HB.Text.H3">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="HB.AgendaBox" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="HB.AgendaTitle" parent="HB.Text">
        <item name="android:textStyle">bold</item>
    </style>
</resources>
