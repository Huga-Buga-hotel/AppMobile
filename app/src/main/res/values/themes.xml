<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HugaBuga" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/hb_orange</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/hb_sand</item>
        <item name="colorSurface">@color/hb_cream</item>
        <item name="colorOnSurface">@color/hb_ink</item>
        <item name="android:windowBackground">@color/hb_cream</item>
        <item name="android:statusBarColor">@color/hb_dark</item>
        <item name="android:navigationBarColor">@color/hb_cream</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="HB.Text" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/hb_ink</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="HB.Text.Display">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HB.Text.H1" parent="HB.Text.Display">
        <item name="android:textSize">@dimen/text_h1</item>
    </style>

    <style name="HB.Text.H2" parent="HB.Text.Display">
        <item name="android:textSize">@dimen/text_h2</item>
    </style>

    <style name="HB.Text.H3" parent="HB.Text.Display">
        <item name="android:textSize">@dimen/text_h3</item>
    </style>

    <style name="HB.Text.Eyebrow">
        <item name="android:textSize">@dimen/text_eyebrow</item>
        <item name="android:textColor">@color/hb_orange</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="HB.Text.Muted">
        <item name="android:textColor">@color/hb_muted</item>
        <item name="android:textSize">@dimen/text_small</item>
    </style>

    <style name="HB.Button.Primary" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="HB.Button.Outline" parent="HB.Button.Primary">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/hb_ink</item>
    </style>

    <style name="HB.Chip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/hb_ink</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="HB.Chip.Selected">
        <item name="android:background">@drawable/bg_chip_selected</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
