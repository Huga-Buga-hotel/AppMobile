<?xml version="1.0" encoding="utf-8"?>
<!-- Tela 03 · Detalhe da Caverna & Reserva (mobile 390) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hb_cream">

    <!-- Top Bar com Voltar, Compartilhar e Salvar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:background="@color/hb_paper"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_avatar"
            android:contentDescription="@null"
            android:padding="5dp"
            android:src="@drawable/ic_chevron_right"
            android:rotation="180" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnShare"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_avatar"
            android:contentDescription="@string/detail_share"
            android:padding="5dp"
            android:src="@drawable/ic_share" />

        <ImageView
            android:id="@+id/btnFavorite"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_avatar"
            android:contentDescription="@string/detail_save"
            android:padding="5dp"
            android:src="@drawable/ic_heart_outline" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bookingBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Galeria de Fotos -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@drawable/bg_photo_placeholder">

                <ImageView
                    android:id="@+id/ivDetailPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/detail_see_photos" />

                <ImageView
                    android:id="@+id/ivDetailPlaceholder"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/detail_see_photos"
                    android:src="@drawable/ic_image_placeholder" />

                <!-- Contador de fotos 1/24 -->
                <TextView
                    android:id="@+id/tvPhotoCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_chip_selected"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="1 / 24"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Aviso de Indisponibilidade / Ocupada -->
            <LinearLayout
                android:id="@+id/layoutOccupiedWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:background="@drawable/bg_warning_card"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_warning_red"
                    android:contentDescription="@null"
                    app:tint="@color/hb_warning_text" />

                <TextView
                    android:id="@+id/tvOccupiedWarningText"
                    style="@style/HB.Text"
                    android:text="Aviso: Esta caverna está ocupada ou sem unidades livres para o período selecionado."
                    android:textColor="@color/hb_warning_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Conteúdo Principal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_margin">

                <!-- Tag & Título -->
                <TextView
                    android:id="@+id/tvCategory"
                    style="@style/HB.Text.Eyebrow"
                    android:text="@string/cavern_1_tag" />

                <TextView
                    android:id="@+id/tvCavernName"
                    style="@style/HB.Text.H1"
                    android:layout_marginTop="4dp"
                    android:text="@string/cavern_1_name" />

                <!-- Avaliação & Localização -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_star" />

                    <TextView
                        android:id="@+id/tvRating"
                        style="@style/HB.Text"
                        android:layout_marginStart="4dp"
                        android:text="@string/cavern_1_rating"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/HB.Text.Muted"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="·"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvLocation"
                        style="@style/HB.Text.Muted"
                        android:drawablePadding="4dp"
                        app:drawableStartCompat="@drawable/ic_location"
                        app:drawableTint="@color/hb_muted"
                        android:text="@string/detail_location"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Descrição -->
                <TextView
                    android:id="@+id/tvDescription"
                    style="@style/HB.Text.Muted"
                    android:layout_marginTop="@dimen/gap_m"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/detail_desc"
                    android:textSize="@dimen/text_body" />



                <!-- Comodidades / Destaques da Caverna -->
                <GridLayout
                    android:id="@+id/gridComodidades"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_l"
                    android:columnCount="2" />

                <!-- Regras da Tribo -->
                <TextView
                    style="@style/HB.Text.H3"
                    android:layout_marginTop="@dimen/gap_l"
                    android:text="@string/detail_rules_title" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_m"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvRuleCheckin"
                        style="@style/HB.Text"
                        android:text="@string/detail_rules_checkin"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/hb_stone" />

                    <TextView
                        android:id="@+id/tvRuleCheckout"
                        style="@style/HB.Text"
                        android:text="@string/detail_rules_checkout"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/hb_stone" />

                    <TextView
                        android:id="@+id/tvRulePets"
                        style="@style/HB.Text"
                        android:text="@string/detail_rules_pets"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/hb_stone" />

                    <TextView
                        style="@style/HB.Text"
                        android:text="Cancelamento grátis em até 2 dias antes do dia da reserva"
                        android:textSize="13sp"
                        app:drawableStartCompat="@drawable/ic_check_circle"
                        android:drawablePadding="8dp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra de Reserva Inferior (Sticky Booking Bar) -->
    <LinearLayout
        android:id="@+id/bookingBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/hb_paper"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPrice"
                    style="@style/HB.Text.H3"
                    android:text="@string/cavern_1_price" />

                <TextView
                    style="@style/HB.Text.Muted"
                    android:layout_marginStart="2dp"
                    android:text="@string/per_night"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutBookingSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/tvBookingSummary"
                    style="@style/HB.Text.Muted"
                    android:text="12 – 15 out · 4 pessoas"
                    android:textSize="11sp" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/hb_muted" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnReserve"
            style="@style/HB.Button.Primary"
            android:layout_width="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/action_reserve" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
