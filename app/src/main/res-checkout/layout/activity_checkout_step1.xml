<?xml version="1.0" encoding="utf-8"?>
<!-- Tela 06 · Reserva Passo 1: Quem Vem? (mobile 390) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hb_cream">

    <!-- Header com Voltar e Título -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:background="@color/hb_paper"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_avatar"
            android:contentDescription="@null"
            android:padding="5dp"
            android:src="@drawable/ic_chevron_right"
            android:rotation="180" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStepTitle"
                style="@style/HB.Text"
                android:text="Reservar Toca do Mamute"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStepSubtitle"
                style="@style/HB.Text.Muted"
                android:text="12–15 out · 4 pessoas"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="@dimen/screen_margin">

            <!-- Stepper -->
            <include layout="@layout/view_checkout_stepper" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_margin">

                <TextView
                    style="@style/HB.Text.Eyebrow"
                    android:text="PEGADA 1 DE 3" />

                <TextView
                    style="@style/HB.Text.H1"
                    android:layout_marginTop="4dp"
                    android:text="@string/step1_heading" />

                <!-- Formulário Chefe da Tribo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_m"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/HB.Text"
                        android:text="@string/step1_chief_title"
                        android:textStyle="bold" />

                    <!-- Campo Nome -->
                    <TextView
                        style="@style/HB.Text.Muted"
                        android:layout_marginTop="12dp"
                        android:text="@string/step1_field_full_name"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etFullName"
                        style="@style/HB.Text"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_chip"
                        android:hint="Marina Souza"
                        android:inputType="textPersonName"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="13sp" />

                    <!-- Campo E-mail -->
                    <TextView
                        style="@style/HB.Text.Muted"
                        android:layout_marginTop="10dp"
                        android:text="@string/step1_field_email"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etEmail"
                        style="@style/HB.Text"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_chip"
                        android:hint="marina@tribo.com"
                        android:inputType="textEmailAddress"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="13sp" />

                    <!-- Campo Celular -->
                    <TextView
                        style="@style/HB.Text.Muted"
                        android:layout_marginTop="10dp"
                        android:text="@string/step1_field_phone"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etPhone"
                        style="@style/HB.Text"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_chip"
                        android:hint="+55 (54) 9 0000-0000"
                        android:inputType="phone"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="13sp" />

                    <!-- Campo Documento (obrigatório na API) -->
                    <TextView
                        style="@style/HB.Text.Muted"
                        android:layout_marginTop="10dp"
                        android:text="CPF do responsável"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etDocument"
                        style="@style/HB.Text"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_chip"
                        android:hint="000.000.000-00"
                        android:inputType="number"
                        android:maxLength="14"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="13sp" />

                    <!-- Idade das crianças -->
                    <TextView
                        style="@style/HB.Text.Muted"
                        android:layout_marginTop="12dp"
                        android:text="@string/step1_kids_ages"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipKid1"
                            style="@style/HB.Chip"
                            android:layout_marginEnd="8dp"
                            android:text="@string/step1_kid_1" />

                        <TextView
                            android:id="@+id/chipKid2"
                            style="@style/HB.Chip"
                            android:text="@string/step1_kid_2" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Resumo da Caçada -->
                <include
                    layout="@layout/view_booking_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_l" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra Inferior (Total & Botão Continuar) -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/hb_paper"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStepTotal"
                style="@style/HB.Text.H3"
                android:text="R$ 1.560" />

            <TextView
                style="@style/HB.Text.Muted"
                android:text="ver resumo"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            style="@style/HB.Button.Primary"
            android:layout_width="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/step1_continue" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
