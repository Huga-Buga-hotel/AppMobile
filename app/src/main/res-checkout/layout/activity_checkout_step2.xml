<?xml version="1.0" encoding="utf-8"?>
<!-- Tela 07 · Reserva Passo 2: Extras (mobile 390) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hb_cream">

    <!-- Header com Voltar e Título -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:background="@color/hb_paper"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_avatar"
            android:contentDescription="@null"
            android:padding="5dp"
            android:src="@drawable/ic_chevron_right"
            android:rotation="180" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/HB.Text"
                android:text="Extras da estadia"
                android:textStyle="bold" />

            <TextView
                style="@style/HB.Text.Muted"
                android:text="PEGADA 2 DE 3"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="@dimen/screen_margin">

            <!-- Stepper -->
            <include layout="@layout/view_checkout_stepper" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_margin">

                <TextView
                    style="@style/HB.Text.H1"
                    android:text="@string/step2_heading" />

                <TextView
                    style="@style/HB.Text.Muted"
                    android:layout_marginTop="4dp"
                    android:text="@string/step2_subheading"
                    android:textSize="@dimen/text_body" />

                <!-- Lista de Opções de Extras -->
                <LinearLayout
                    android:id="@+id/containerExtras"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_m"
                    android:orientation="vertical">

                    <include layout="@layout/item_extra_option" />
                    <include layout="@layout/item_extra_option" />
                    <include layout="@layout/item_extra_option" />
                    <include layout="@layout/item_extra_option" />
                </LinearLayout>

                <!-- Resumo da Caçada -->
                <include
                    layout="@layout/view_booking_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_l" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra Inferior de Navegação -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/hb_paper"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btnSkipExtras"
            style="@style/HB.Button.Outline"
            android:layout_width="0dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/step2_skip" />

        <TextView
            android:id="@+id/btnToPayment"
            style="@style/HB.Button.Primary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/step2_to_payment" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
