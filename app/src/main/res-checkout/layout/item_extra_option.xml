<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_extra_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvExtraTitle"
            style="@style/HB.Text"
            android:text="@string/extra_2_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvExtraDesc"
            style="@style/HB.Text.Muted"
            android:layout_marginTop="2dp"
            android:text="@string/extra_2_desc"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvExtraPrice"
            style="@style/HB.Text"
            android:layout_marginTop="4dp"
            android:text="@string/extra_2_price"
            android:textColor="@color/hb_orange"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Botão de Ação ou Contador -->
    <TextView
        android:id="@+id/btnExtraAdd"
        style="@style/HB.Button.Outline"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/action_reserve"
        android:textSize="12sp" />
</LinearLayout>
