<?xml version="1.0" encoding="utf-8"?>
<!-- Tela 09 · Confirmação / Voucher / Pass Ticket (mobile 390) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hb_dark">

    <!-- Top Bar com Fechar, Título e Compartilhar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:background="@color/hb_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            style="@style/HB.Text"
            android:text="✕"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            style="@style/HB.Text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/voucher_title"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnShare"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/detail_share"
            android:padding="4dp"
            android:src="@drawable/ic_share"
            app:tint="@color/white" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin">

            <!-- Banner de Sucesso -->
            <TextView
                style="@style/HB.Text.H1"
                android:text="@string/voucher_badge"
                android:textColor="@color/hb_orange" />

            <TextView
                android:id="@+id/tvVoucherDesc"
                style="@style/HB.Text.Muted"
                android:layout_marginTop="8dp"
                android:text="@string/voucher_desc"
                android:textColor="@color/hb_stone_dark"
                android:textSize="@dimen/text_body" />

            <!-- Card Voucher ("Tábua de Pedra") -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_l"
                android:background="@drawable/bg_voucher_card"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Cabeçalho do Card: Nome e Código -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvVoucherCavernName"
                        style="@style/HB.Text.H2"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/cavern_1_name" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <TextView
                            style="@style/HB.Text.Eyebrow"
                            android:text="@string/voucher_code_label"
                            android:textColor="@color/hb_muted"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/tvVoucherCode"
                            style="@style/HB.Text"
                            android:text="@string/voucher_code"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/hb_stone" />

                <!-- Datas Check-in / Check-out -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/HB.Text.Eyebrow"
                            android:text="CHEGADA" />

                        <TextView
                            android:id="@+id/tvVoucherCheckInDate"
                            style="@style/HB.Text.H2"
                            android:text="12 OUT" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            style="@style/HB.Text.Eyebrow"
                            android:text="PARTIDA" />

                        <TextView
                            android:id="@+id/tvVoucherCheckOutDate"
                            style="@style/HB.Text.H2"
                            android:text="15 OUT" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/hb_stone" />

                <!-- Detalhes Extras -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvVoucherTribeCount"
                        style="@style/HB.Text.Muted"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="4 na tribo"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvVoucherTotal"
                        style="@style/HB.Text.Muted"
                        android:text="R$ 1.560"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Quadro QR Code de Acesso à Porta -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_m"
                    android:background="@drawable/bg_chip"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:background="@drawable/bg_qr_box"
                        android:padding="10dp">

                        <ImageView
                            android:id="@+id/ivVoucherQrCode"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_qr_code" />
                    </FrameLayout>

                    <TextView
                        style="@style/HB.Text.Muted"
                        android:layout_marginTop="8dp"
                        android:text="@string/voucher_qr_hint"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Ações "Antes de chegar na caverna" -->
            <TextView
                style="@style/HB.Text.H3"
                android:layout_marginTop="@dimen/gap_l"
                android:text="@string/before_arrival_title"
                android:textColor="@color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Check-in Online -->
                <LinearLayout
                    android:id="@+id/btnActionCheckin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        style="@style/HB.Text"
                        android:text="@string/before_action_checkin"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/HB.Text.Muted"
                        android:text="@string/before_action_checkin_sub"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@color/hb_stone" />

                <!-- Aventuras -->
                <LinearLayout
                    android:id="@+id/btnActionAdventures"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        style="@style/HB.Text"
                        android:text="@string/before_action_adventures"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/HB.Text.Muted"
                        android:text="@string/before_action_adventures_sub"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@color/hb_stone" />

                <!-- O Banquete -->
                <LinearLayout
                    android:id="@+id/btnActionBanquet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        style="@style/HB.Text"
                        android:text="@string/before_action_banquet"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/HB.Text.Muted"
                        android:text="@string/before_action_banquet_sub"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra Inferior de Ações (Baixar Voucher) -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/hb_dark"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btnDownloadVoucher"
            style="@style/HB.Button.Primary"
            android:layout_width="match_parent"
            android:text="Baixar voucher" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
