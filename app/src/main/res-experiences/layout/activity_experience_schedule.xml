<?xml version="1.0" encoding="utf-8"?>
<!-- Tela de Agendamento da Experiência: Mostra os Dias da Reserva, Horários Disponíveis e Agenda -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hb_cream">

    <include
        android:id="@+id/appBar"
        layout="@layout/view_app_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin">

            <TextView
                android:id="@+id/tvExpScheduleEyebrow"
                style="@style/HB.Text.Eyebrow"
                android:text="DIAS E HORÁRIOS DA RESERVA" />

            <TextView
                android:id="@+id/tvExpScheduleTitle"
                style="@style/HB.Text.H1"
                android:layout_marginTop="4dp"
                android:text="Agendar Experiência" />

            <TextView
                android:id="@+id/tvExpScheduleSub"
                style="@style/HB.Text.Muted"
                android:layout_marginTop="@dimen/gap_s"
                android:text="Escolha o dia e horário da sua estadia para confirmar sua vaga na tribo."
                android:textSize="@dimen/text_body" />

            <!-- Faixa de dias correspondentes à reserva escolhida -->
            <TextView
                style="@style/HB.Text.H3"
                android:layout_marginTop="@dimen/gap_l"
                android:text="Dias da sua Estadia" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/daysList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_day" />

            <!-- Sessões / Horários Disponíveis -->
            <TextView
                android:id="@+id/tvHorariosDisponiveisTitle"
                style="@style/HB.Text.H3"
                android:layout_marginTop="@dimen/gap_l"
                android:text="Horários Disponíveis" />

            <LinearLayout
                android:id="@+id/layoutSessionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnAddExperienceManagement"
                style="@style/HB.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:text="➕ Adicionar Nova Experiência"
                android:visibility="gone" />

            <!-- Agenda da tribo para esta reserva -->
            <include layout="@layout/view_agenda" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/hb_cream"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Banner de Pagamento Pendente para reservas feitas via Pix ou Cartão -->
        <LinearLayout
            android:id="@+id/layoutPendingPaymentBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_warning_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPendingPaymentText"
                    style="@style/HB.Text"
                    android:text="Pendente: R$ 60,00 (Pague no app ou na recepção)"
                    android:textColor="@color/hb_warning_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/HB.Text.Muted"
                    android:text="Reserva via Pix / Cartão (Pendente de acerto)"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnPayPendingInApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_selected"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Acertar no App"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnConfirmExperienceSchedule"
            style="@style/HB.Button.Primary"
            android:text="Confirmar Reserva da Experiência" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
