<?xml version="1.0" encoding="utf-8"?>
<!-- Linha de atividade (versão mobile) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/gap_m"
    android:background="@drawable/bg_card"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="@dimen/thumb_size"
        android:layout_height="@dimen/thumb_size"
        android:background="@drawable/bg_photo_placeholder"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/photo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/photo_placeholder"
            android:src="@drawable/ic_image_placeholder" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/HB.Text.H3"
            android:text="@string/exp_trail" />

        <TextView
            android:id="@+id/meta"
            style="@style/HB.Text.Muted"
            android:layout_marginTop="2dp"
            android:text="@string/exp_trail_meta" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_s"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/price"
                style="@style/HB.Text.H2"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/price_90" />

            <TextView
                android:id="@+id/spots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/spots_left_2"
                android:textColor="@color/hb_orange"
                android:textSize="@dimen/text_small"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
