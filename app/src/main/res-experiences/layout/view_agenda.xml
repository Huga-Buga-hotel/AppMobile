<?xml version="1.0" encoding="utf-8"?>
<!-- Agenda da sua tribo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/gap_l"
    android:layout_marginBottom="@dimen/gap_l"
    android:background="@drawable/bg_card_sand"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvAgendaDateEyebrow"
        style="@style/HB.Text.Eyebrow"
        android:text="SÁBADO, 12 DE DEZEMBRO" />

    <TextView
        android:id="@+id/tvAgendaTitle"
        style="@style/HB.Text.H2"
        android:text="@string/agenda_title" />

    <!-- 08h -->
    <LinearLayout style="@style/HB.AgendaRow">
        <TextView style="@style/HB.AgendaHour" android:text="@string/agenda_8h" />
        <LinearLayout
            android:id="@+id/boxAgenda8h"
            style="@style/HB.AgendaBox"
            android:background="@drawable/bg_dashed"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvAgenda8hTitle"
                    style="@style/HB.AgendaTitle"
                    android:drawableStart="@drawable/ic_plus"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/hb_ink"
                    android:text="Horário Livre" />
                <TextView
                    android:id="@+id/tvAgenda8hSub"
                    style="@style/HB.Text.Muted"
                    android:text="LIVRE" />
            </LinearLayout>
            <TextView
                android:id="@+id/btnCancelAgenda8h"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_red"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Cancelar"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

