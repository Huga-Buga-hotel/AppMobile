<?xml version="1.0" encoding="utf-8"?>
<!-- Agenda da sua tribo: os itens (café, atividades, mesa) vêm de GET /reservas/{codigo}/agenda -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/gap_l"
    android:layout_marginBottom="@dimen/gap_l"
    android:background="@drawable/bg_card_sand"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvAgendaDateEyebrow"
        style="@style/HB.Text.Eyebrow"
        android:text="" />

    <TextView
        android:id="@+id/tvAgendaTitle"
        style="@style/HB.Text.H2"
        android:text="@string/agenda_title" />

    <LinearLayout
        android:id="@+id/layoutAgendaItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/tvAgendaEmpty"
        style="@style/HB.Text.Muted"
        android:layout_marginTop="@dimen/gap_m"
        android:text="Nada agendado para este dia ainda."
        android:visibility="gone" />
</LinearLayout>
