<?xml version="1.0" encoding="utf-8"?>
<!-- Card de Atividade Destaque / Mais Popular -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/gap_m"
    android:background="@drawable/bg_card_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvFeaturedBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="🔥 MAIS POPULAR DA TRIBO"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvFeaturedTitle"
        style="@style/HB.Text.H2"
        android:layout_marginTop="@dimen/gap_s"
        android:text="Escavação de ovo de dino"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/tvFeaturedDesc"
        style="@style/HB.Text.Muted"
        android:layout_marginTop="4dp"
        android:text="Procure fósseis na areia vulcânica com ferramentas de paleontólogo"
        android:textColor="@color/hb_stone_dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_m"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvFeaturedPrice"
            style="@style/HB.Text.H2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Grátis"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/btnFeaturedReserve"
            style="@style/HB.Button.Primary"
            android:layout_width="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/action_reserve" />
    </LinearLayout>
</LinearLayout>
