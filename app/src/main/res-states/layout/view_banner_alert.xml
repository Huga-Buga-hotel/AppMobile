<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_warning_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvAlertIcon"
        style="@style/HB.Text"
        android:text="🔥 "
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvAlertMessage"
        style="@style/HB.Text"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:text="@string/alert_urgency_2_left"
        android:textColor="@color/hb_warning_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btnAlertAction"
        style="@style/HB.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/btn_guarantee"
        android:textSize="11sp" />
</LinearLayout>
