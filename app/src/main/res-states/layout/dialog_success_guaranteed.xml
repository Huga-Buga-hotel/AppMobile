<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_check_circle" />

    <TextView
        style="@style/HB.Text.H2"
        android:layout_marginTop="12dp"
        android:text="@string/success_guaranteed_title" />

    <TextView
        style="@style/HB.Text"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Escavação de ovo de dino · sáb 13 out · 10h"
        android:textStyle="bold" />

    <TextView
        style="@style/HB.Text.Muted"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="2 crianças · R$ 120 na conta da toca"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_l"
        android:orientation="horizontal">

        <TextView
            style="@style/HB.Button.Primary"
            android:layout_width="0dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/btn_view_agenda" />

        <TextView
            style="@style/HB.Button.Outline"
            android:layout_width="0dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/btn_close" />
    </LinearLayout>
</LinearLayout>
