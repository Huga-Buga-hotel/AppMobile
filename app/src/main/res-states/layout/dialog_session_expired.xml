<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/HB.Text.H2"
        android:text="@string/expired_session_title" />

    <TextView
        style="@style/HB.Text.Muted"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/expired_session_desc"
        android:textSize="@dimen/text_body" />

    <TextView
        style="@style/HB.Button.Primary"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/gap_l"
        android:text="@string/btn_reignite" />

    <TextView
        style="@style/HB.Text.Muted"
        android:layout_marginTop="12dp"
        android:text="@string/auth_guest_link"
        android:textSize="12sp" />
</LinearLayout>
